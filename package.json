{
  "name": "@xtree/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the XTREE API — real-time raw data layer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["xtree", "wechat", "api", "sdk"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtree-io/xtree-sdk.git"
  },
  "homepage": "https://www.xtree.io",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
